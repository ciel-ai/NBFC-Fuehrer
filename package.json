{
  "name": "nbfc-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified NBFC Monorepo containing backend modules and frontend mobile/web portals",
  "workspaces": [
    "backend/*",
    "frontend/mobile",
    "frontend/web/*",
    "frontend/shared"
  ],
  "scripts": {
    "dev:user": "npm run dev --workspace=fuehrer-user-module",
    "dev:business": "npm run dev --workspace=feuhrer-business-api",
    "dev:admin": "npm run dev --workspace=fuehrer-nbfc-webdash",
    "dev:mobile": "npm run start --workspace=fuehrer-nbfc"
  }
}

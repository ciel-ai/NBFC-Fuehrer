generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                String              @id @default(uuid()) @db.Uuid
  phone             String              @unique @db.VarChar(15)
  full_name         String              @db.VarChar(100)
  email             String?             @unique @db.VarChar(255)
  fcm_token         String?             @db.VarChar(500)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @updatedAt @db.Timestamptz(6)
  agent             agents?
  kyc_documents     kyc_documents?
  loan_accounts     loan_accounts[]
  loan_applications loan_applications[]
  customer          customers?

  @@index([phone])
  @@index([email])
  @@index([is_active])
}

model kyc_documents {
  id                      String    @id @default(uuid()) @db.Uuid
  user_id                 String    @unique @db.Uuid
  aadhaar_encrypted       String?
  pan_encrypted           String?
  aadhaar_last4           String?   @db.VarChar(4)
  pan_masked              String?   @db.VarChar(10)
  selfie_s3_key           String?   @db.VarChar(500)
  aadhaar_front_s3_key    String?   @db.VarChar(500)
  aadhaar_back_s3_key     String?   @db.VarChar(500)
  pan_s3_key              String?   @db.VarChar(500)
  bank_statement_s3_key   String?   @db.VarChar(500)
  signed_agreement_s3_key String?   @db.VarChar(500)
  liveness_score          Decimal?  @db.Decimal(5, 2)
  face_match_score        Decimal?  @db.Decimal(5, 2)
  fraud_score             Decimal?  @db.Decimal(5, 2)
  credit_score            Int?
  esign_request_id        String?   @db.VarChar(100)
  esign_status            String?   @db.VarChar(30)
  signzy_responses        Json?
  overall_status          String    @default("NOT_STARTED") @db.VarChar(30)
  completed_checks        String[]  @default([])
  failed_checks           String[]  @default([])
  rejection_reason        String?
  verified_at             DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)
  user                    users     @relation(fields: [user_id], references: [id])

  @@index([overall_status])
  @@index([user_id])
}

model agents {
  id                 String               @id @default(uuid()) @db.Uuid
  user_id            String               @unique @db.Uuid
  agent_code         String               @unique @db.VarChar(20)
  full_name          String               @db.VarChar(100)
  phone              String               @unique @db.VarChar(15)
  email              String?              @db.VarChar(255)
  shop_name          String               @db.VarChar(100)
  shop_address       String               @db.VarChar(300)
  shop_city          String               @db.VarChar(100)
  shop_pincode       String               @db.VarChar(6)
  bank_account_no    String               @db.VarChar(30)
  bank_ifsc          String               @db.VarChar(11)
  bank_account_name  String               @db.VarChar(100)
  status             String               @default("PENDING") @db.VarChar(20)
  commission_rate    Decimal              @default(0.015) @db.Decimal(6, 4)
  pan_number         String?              @db.VarChar(10)
  aadhaar_last4      String?              @db.VarChar(4)
  suspension_reason  String?
  onboarded_at       DateTime             @default(now()) @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @updatedAt @db.Timestamptz(6)
  agent_commissions  agent_commissions[]
  user               users                @relation(fields: [user_id], references: [id])
  commission_payouts commission_payouts[]
  loan_applications  loan_applications[]

  @@index([status])
  @@index([shop_city])
  @@index([agent_code])
}

model customers {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @unique @db.Uuid
  flat_house_no   String?  @db.VarChar(100)
  street_area     String?  @db.VarChar(200)
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  pincode         String?  @db.VarChar(6)
  employment_type String?  @db.VarChar(30)
  employer_name   String?  @db.VarChar(200)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)
  user              users               @relation(fields: [user_id], references: [id])
  loan_applications loan_applications[]
  appointments    appointments[]

  @@index([user_id])
}

model loan_applications {
  id                   String                 @id @default(uuid()) @db.Uuid
  user_id              String                 @db.Uuid
  agent_id             String?                @db.Uuid
  status               String                 @default("DRAFT") @db.VarChar(30)
  amount_requested     Decimal                @db.Decimal(15, 2)
  tenure_months        Int
  product_type         String                 @db.VarChar(50)
  purpose              String                 @db.VarChar(200)
  store_name           String                 @db.VarChar(100)
  store_city           String                 @db.VarChar(100)
  approved_amount      Decimal?               @db.Decimal(15, 2)
  interest_rate        Decimal?               @db.Decimal(6, 2)
  processing_fee       Decimal?               @db.Decimal(15, 2)
  processing_fee_gst   Decimal?               @db.Decimal(15, 2)
  monthly_emi          Decimal?               @db.Decimal(15, 2)
  rejection_reason     String?
  reviewed_by          String?                @db.Uuid
  reviewed_at          DateTime?              @db.Timestamptz(6)
  applied_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @updatedAt @db.Timestamptz(6)
  nominee_name         String?  @db.VarChar(100)
  nominee_relationship String?  @db.VarChar(50)
  nominee_address      String?
  nominee_age          Int?
  preferred_debit_day Int?    @default(4)
  is_priority_sector Boolean? @default(false)
  priority_category  String?  @db.VarChar(50)
  loan_purpose       String?  @db.VarChar(100)
  crop_details       String?  @db.VarChar(200)
  land_extent        String?  @db.VarChar(100)
  survey_number      String?  @db.VarChar(50)
  village            String?  @db.VarChar(100)
  taluk              String?  @db.VarChar(100)
  
  
  monthly_income       Decimal?               @db.Decimal(12, 2)
  repayment_type       String                 @default("MONTHLY_EMI") @db.VarChar(20)
  reference_number     String?                @unique @db.VarChar(20)
  customer_id          String?                @db.Uuid
  customer             customers?             @relation(fields: [customer_id], references: [id])
  bureau_reports       bureau_reports?
  collateral_gold      collateral_gold?
  collateral_property  collateral_property?
  loan_account         loan_accounts?
  agent                agents?                @relation(fields: [agent_id], references: [id])
  user                 users                  @relation(fields: [user_id], references: [id])
  underwriting_reports underwriting_reports[]
  appointments    appointments[]

  @@index([user_id])
  @@index([agent_id])
  @@index([status])
  @@index([status, applied_at])
  @@index([agent_id, status])
  @@index([applied_at])
  @@index([customer_id])
}

model loan_accounts {
  id                  String              @id @default(uuid()) @db.Uuid
  application_id      String              @unique @db.Uuid
  user_id             String              @db.Uuid
  account_number      String              @unique @db.VarChar(20)
  principal_amount    Decimal             @db.Decimal(15, 2)
  interest_rate       Decimal             @db.Decimal(6, 2)
  tenure_months       Int
  monthly_emi         Decimal             @db.Decimal(15, 2)
  outstanding_balance Decimal             @db.Decimal(15, 2)
  total_interest      Decimal             @db.Decimal(15, 2)
  status              String              @default("DISBURSED") @db.VarChar(20)
  repayment_mode      String              @default("IMPS") @db.VarChar(20)
  razorpay_mandate_id String?             @db.VarChar(100)
  disbursed_at        DateTime?           @db.Timestamptz(6)
  closed_at           DateTime?           @db.Timestamptz(6)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @updatedAt @db.Timestamptz(6)
  agent_commissions   agent_commissions[]
  collection_cases    collection_cases[]
  disbursements       disbursements[]
  emi_schedule        emi_schedule[]
  enach_mandates      enach_mandates[]
  application         loan_applications   @relation(fields: [application_id], references: [id])
  user                users               @relation(fields: [user_id], references: [id])
  payments            payments[]

  @@index([user_id])
  @@index([status])
  @@index([account_number])
  @@index([razorpay_mandate_id])
  @@index([disbursed_at])
  @@index([status, disbursed_at])
}

model underwriting_reports {
  id                     String            @id @default(uuid()) @db.Uuid
  loan_id                String            @db.Uuid
  user_id                String            @db.Uuid
  decision               String            @db.VarChar(20)
  credit_score           Int?
  internal_score         Int
  fraud_score            Decimal?          @db.Decimal(5, 2)
  monthly_income         Decimal?          @db.Decimal(15, 2)
  existing_emi_per_month Decimal?          @db.Decimal(15, 2)
  requested_emi          Decimal           @db.Decimal(15, 2)
  foir                   Decimal?          @db.Decimal(6, 4)
  dti                    Decimal?          @db.Decimal(6, 4)
  rule_results           Json
  passed_rules           Int
  failed_rules           Int
  hard_fail_rules        String[]          @default([])
  recommended_amount     Decimal?          @db.Decimal(15, 2)
  recommended_rate       Decimal?          @db.Decimal(6, 2)
  recommended_tenure     Int?
  max_eligible_amount    Decimal?          @db.Decimal(15, 2)
  rejection_reasons      String[]          @default([])
  referral_reasons       String[]          @default([])
  notes                  String?
  completed_at           DateTime          @default(now()) @db.Timestamptz(6)
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime          @updatedAt @db.Timestamptz(6)
  loan_application       loan_applications @relation(fields: [loan_id], references: [id])

  @@index([loan_id])
  @@index([decision])
  @@index([loan_id, created_at])
}

model emi_schedule {
  id                  String        @id @default(uuid()) @db.Uuid
  loan_account_id     String        @db.Uuid
  emi_number          Int
  due_date            DateTime      @db.Date
  emi_amount          Decimal       @db.Decimal(15, 2)
  principal_component Decimal       @db.Decimal(15, 2)
  interest_component  Decimal       @db.Decimal(15, 2)
  outstanding_after   Decimal       @db.Decimal(15, 2)
  status              String        @default("PENDING") @db.VarChar(20)
  penalty_amount      Decimal       @default(0) @db.Decimal(15, 2)
  bounce_count        Int           @default(0)
  last_bounce_at      DateTime?     @db.Timestamptz(6)
  next_retry_at       DateTime?     @db.Timestamptz(6)
  collection_id       String?       @db.Uuid
  paid_at             DateTime?     @db.Timestamptz(6)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)
  loan_account        loan_accounts @relation(fields: [loan_account_id], references: [id])
  payments            payments[]

  @@unique([loan_account_id, emi_number])
  @@index([loan_account_id])
  @@index([status])
  @@index([due_date])
  @@index([status, due_date])
  @@index([loan_account_id, status])
  @@index([next_retry_at])
}

model disbursements {
  id                   String         @id @default(uuid()) @db.Uuid
  loan_id              String         @db.Uuid
  loan_account_id      String?        @db.Uuid
  user_id              String         @db.Uuid
  beneficiary_name     String         @db.VarChar(100)
  account_number       String         @db.VarChar(30)
  ifsc                 String         @db.VarChar(11)
  mode                 String         @db.VarChar(20)
  principal_amount     Decimal        @db.Decimal(15, 2)
  processing_fee       Decimal        @db.Decimal(15, 2)
  processing_fee_gst   Decimal        @db.Decimal(15, 2)
  net_disbursed_amount Decimal        @db.Decimal(15, 2)
  razorpay_payout_id   String?        @db.VarChar(100)
  utr_number           String?        @db.VarChar(50)
  status               String         @default("PENDING") @db.VarChar(20)
  failure_reason       String?
  initiated_by         String         @db.Uuid
  initiated_at         DateTime       @db.Timestamptz(6)
  completed_at         DateTime?      @db.Timestamptz(6)
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime       @updatedAt @db.Timestamptz(6)
  loan_account         loan_accounts? @relation(fields: [loan_account_id], references: [id])

  @@index([loan_id])
  @@index([loan_account_id])
  @@index([status])
  @@index([razorpay_payout_id])
  @@index([initiated_at])
}

model payments {
  id               String        @id @default(uuid()) @db.Uuid
  loan_account_id  String        @db.Uuid
  user_id          String        @db.Uuid
  emi_id           String?       @db.Uuid
  payment_type     String        @db.VarChar(20)
  amount           Decimal       @db.Decimal(15, 2)
  penalty_amount   Decimal       @default(0) @db.Decimal(15, 2)
  total_collected  Decimal       @db.Decimal(15, 2)
  channel          String        @db.VarChar(20)
  gateway          String        @db.VarChar(30)
  gateway_txn_id   String?       @db.VarChar(100)
  utr_number       String?       @db.VarChar(50)
  status           String        @default("PENDING") @db.VarChar(20)
  failure_reason   String?
  failure_code     String?       @db.VarChar(50)
  mandate_id       String?       @db.VarChar(100)
  debit_attempt_no Int           @default(1)
  initiated_at     DateTime      @default(now()) @db.Timestamptz(6)
  settled_at       DateTime?     @db.Timestamptz(6)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @updatedAt @db.Timestamptz(6)
  emi              emi_schedule? @relation(fields: [emi_id], references: [id])
  loan_account     loan_accounts @relation(fields: [loan_account_id], references: [id])

  @@index([loan_account_id])
  @@index([emi_id])
  @@index([status])
  @@index([gateway_txn_id])
  @@index([channel, status])
  @@index([initiated_at])
  @@index([loan_account_id, status])
}

model enach_mandates {
  id                  String        @id @default(uuid()) @db.Uuid
  loan_account_id     String        @db.Uuid
  user_id             String        @db.Uuid
  razorpay_mandate_id String        @unique @db.VarChar(100)
  bank_account        String        @db.VarChar(30)
  ifsc                String        @db.VarChar(11)
  max_amount          Decimal       @db.Decimal(15, 2)
  status              String        @default("CREATED") @db.VarChar(30)
  registered_at       DateTime?     @db.Timestamptz(6)
  cancelled_at        DateTime?     @db.Timestamptz(6)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)
  loan_account        loan_accounts @relation(fields: [loan_account_id], references: [id])
  debit_day          Int      @default(4)

  @@index([loan_account_id])
  @@index([status])
  @@index([razorpay_mandate_id])
}

model agent_commissions {
  id                      String              @id @default(uuid()) @db.Uuid
  agent_id                String              @db.Uuid
  loan_account_id         String              @db.Uuid
  user_id                 String              @db.Uuid
  commission_amount       Decimal             @db.Decimal(15, 2)
  status                  String              @default("EARNED") @db.VarChar(20)
  clawback_eligible_until DateTime            @db.Timestamptz(6)
  clawback_reason         String?
  clawed_back_at          DateTime?           @db.Timestamptz(6)
  payout_id               String?             @db.Uuid
  earned_at               DateTime            @default(now()) @db.Timestamptz(6)
  paid_at                 DateTime?           @db.Timestamptz(6)
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  updated_at              DateTime            @updatedAt @db.Timestamptz(6)
  agent                   agents              @relation(fields: [agent_id], references: [id])
  loan_account            loan_accounts       @relation(fields: [loan_account_id], references: [id])
  payout                  commission_payouts? @relation(fields: [payout_id], references: [id])

  @@index([agent_id])
  @@index([loan_account_id])
  @@index([status])
  @@index([agent_id, status])
  @@index([clawback_eligible_until])
}

model commission_payouts {
  id             String              @id @default(uuid()) @db.Uuid
  agent_id       String              @db.Uuid
  total_amount   Decimal             @db.Decimal(15, 2)
  commission_ids String[]            @default([])
  utr_number     String?             @db.VarChar(50)
  status         String              @default("PENDING") @db.VarChar(20)
  processed_at   DateTime?           @db.Timestamptz(6)
  created_at     DateTime            @default(now()) @db.Timestamptz(6)
  updated_at     DateTime            @updatedAt @db.Timestamptz(6)
  commissions    agent_commissions[]
  agent          agents              @relation(fields: [agent_id], references: [id])

  @@index([agent_id])
  @@index([status])
}

model collection_cases {
  id                String         @id @default(uuid()) @db.Uuid
  loan_account_id   String         @db.Uuid
  user_id           String         @db.Uuid
  assigned_to       String?        @db.Uuid
  overdue_days      Int
  overdue_amount    Decimal        @db.Decimal(15, 2)
  penalty_amount    Decimal        @default(0) @db.Decimal(15, 2)
  total_due         Decimal        @db.Decimal(15, 2)
  status            String         @default("OPEN") @db.VarChar(20)
  ptp_date          DateTime?      @db.Date
  ptp_amount        Decimal?       @db.Decimal(15, 2)
  ptp_broken        Boolean        @default(false)
  opened_at         DateTime       @default(now()) @db.Timestamptz(6)
  resolved_at       DateTime?      @db.Timestamptz(6)
  closed_at         DateTime?      @db.Timestamptz(6)
  close_reason      String?
  last_contact_at   DateTime?      @db.Timestamptz(6)
  contact_count     Int            @default(0)
  escalation_level  Int            @default(0)
  escalated_at      DateTime?      @db.Timestamptz(6)
  escalation_reason String?
  notes             String?
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @updatedAt @db.Timestamptz(6)
  assigned_agent    admin_users?   @relation("AssignedAgent", fields: [assigned_to], references: [id])
  loan_account      loan_accounts  @relation(fields: [loan_account_id], references: [id])
  contact_logs      contact_logs[]

  @@index([loan_account_id])
  @@index([status])
  @@index([assigned_to])
  @@index([overdue_days])
  @@index([status, overdue_days])
  @@index([ptp_date])
  @@index([opened_at])
}

model contact_logs {
  id               String           @id @default(uuid()) @db.Uuid
  case_id          String           @db.Uuid
  logged_by        String           @db.Uuid
  outcome          String           @db.VarChar(40)
  channel          String           @db.VarChar(20)
  ptp_date         DateTime?        @db.Date
  ptp_amount       Decimal?         @db.Decimal(15, 2)
  payment_received Decimal?         @db.Decimal(15, 2)
  notes            String
  contacted_at     DateTime         @default(now()) @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  collection_case  collection_cases @relation(fields: [case_id], references: [id])

  @@index([case_id])
  @@index([logged_by])
  @@index([contacted_at])
  @@index([case_id, contacted_at])
}

model webhook_logs {
  id               String    @id @default(uuid()) @db.Uuid
  source           String    @db.VarChar(30)
  event            String    @db.VarChar(100)
  gateway_event_id String?   @db.VarChar(200)
  status           String    @db.VarChar(20)
  processing_ms    Int
  error_message    String?
  received_at      DateTime  @db.Timestamptz(6)
  processed_at     DateTime? @db.Timestamptz(6)

  @@index([gateway_event_id])
  @@index([source, gateway_event_id])
  @@index([status, received_at])
  @@index([received_at])
}

model audit_logs {
  id           String   @id @default(uuid()) @db.Uuid
  action       String   @db.VarChar(100)
  entity_type  String?  @db.VarChar(50)
  entity_id    String?  @db.Uuid
  user_id      String?  @db.Uuid
  role         String?  @db.VarChar(30)
  request_id   String   @db.VarChar(36)
  ip_address   String?  @db.VarChar(45)
  user_agent   String?  @db.VarChar(500)
  http_method  String?  @db.VarChar(10)
  http_path    String?  @db.VarChar(500)
  status_code  Int?
  before_state String?
  after_state  String?
  metadata     String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id])
  @@index([user_id, created_at])
  @@index([request_id])
  @@index([action, created_at])
  @@index([created_at])
}

model notification_deliveries {
  id           String    @id @default(uuid()) @db.Uuid
  template_key String    @db.VarChar(60)
  channel      String    @db.VarChar(10)
  recipient    String    @db.VarChar(500)
  status       String    @db.VarChar(20)
  message_id   String?   @db.VarChar(100)
  error        String?
  sent_at      DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([template_key, created_at])
  @@index([channel, status])
  @@index([created_at])
}

model admin_users {
  id                                        String             @id @default(uuid()) @db.Uuid
  full_name                                 String             @db.VarChar(100)
  email                                     String             @unique @db.VarChar(255)
  phone                                     String             @unique @db.VarChar(15)
  role                                      String             @db.VarChar(30)
  status                                    String             @default("ACTIVE") @db.VarChar(20)
  department                                String?            @db.VarChar(100)
  last_login_at                             DateTime?          @db.Timestamptz(6)
  created_at                                DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime           @updatedAt @db.Timestamptz(6)
  username                                  String?            @unique @db.VarChar(50)
  password_hash                             String?            @db.VarChar(255)
  product                                   String?            @default("ALL") @db.VarChar(20)
  branch_id                                 String?            @db.Uuid
  must_change_password                      Boolean?           @default(true)
  created_by                                String?            @db.Uuid
  is_active                                 Boolean?           @default(true)
  branch                                    branches?          @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  branches_branches_manager_idToadmin_users branches[]         @relation("branches_manager_idToadmin_users")
  collection_cases                          collection_cases[] @relation("AssignedAgent")
  refresh_tokens                            admin_refresh_tokens[]
  

  @@index([role, status])
  @@index([email])
  @@index([username])
  @@index([product])
}

model branches {
  id                                           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                         String        @db.VarChar(100)
  address                                      String        @db.VarChar(300)
  city                                         String        @db.VarChar(50)
  state                                        String        @db.VarChar(50)
  pincode                                      String        @db.VarChar(10)
  phone                                        String?       @db.VarChar(15)
  manager_id                                   String?       @db.Uuid
  lat                                          Decimal?      @db.Decimal(9, 6)
  lng                                          Decimal?      @db.Decimal(9, 6)
  working_hours                                String?       @db.VarChar(100)
  is_active                                    Boolean?      @default(true)
  created_at                                   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                   DateTime      @default(now()) @db.Timestamptz(6)
  admin_users                                  admin_users[]
  admin_users_branches_manager_idToadmin_users admin_users?  @relation("branches_manager_idToadmin_users", fields: [manager_id], references: [id], onUpdate: NoAction)
  appointments  appointments[]

  @@index([city])
  @@index([is_active])
}

model system_config {
  key         String   @id @db.VarChar(60)
  value       String   @db.VarChar(500)
  description String   @db.VarChar(300)
  updated_by  String   @db.Uuid
  updated_at  DateTime @db.Timestamptz(6)
}

model operational_overrides {
  id           String   @id @default(uuid()) @db.Uuid
  target_type  String   @db.VarChar(50)
  target_id    String   @db.VarChar(100)
  action       String   @db.VarChar(100)
  reason       String
  performed_by String   @db.Uuid
  performed_at DateTime @db.Timestamptz(6)
  metadata     String?

  @@index([target_type, target_id])
  @@index([performed_by])
  @@index([performed_at])
}

model report_audit_log {
  id           String   @id @default(uuid()) @db.Uuid
  report_type  String   @db.VarChar(60)
  format       String   @db.VarChar(10)
  generated_by String   @db.Uuid
  from_date    DateTime @db.Date
  to_date      DateTime @db.Date
  row_count    Int?
  generated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([report_type, generated_at])
  @@index([generated_by])
}

model bureau_accounts {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bureau_report_id   String         @db.Uuid
  lender             String?        @db.VarChar(100)
  account_type       String?        @db.VarChar(50)
  sanctioned_amount  Decimal?       @db.Decimal(15, 2)
  outstanding_amount Decimal?       @db.Decimal(15, 2)
  opened_on          DateTime?      @db.Date
  status             String?        @db.VarChar(20)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  bureau_reports     bureau_reports @relation(fields: [bureau_report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bureau_report_id], map: "bureau_accounts_report_id_idx")
}

model bureau_reports {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id              String            @unique @db.Uuid
  provider             String            @default("CIBIL") @db.VarChar(30)
  score                Int               @db.SmallInt
  report_date          DateTime          @db.Date
  enquiries_6m         Int?              @db.SmallInt
  total_accounts       Int?              @db.SmallInt
  active_accounts      Int?              @db.SmallInt
  overdue_accounts     Int?              @db.SmallInt
  oldest_account_years Decimal?          @db.Decimal(4, 1)
  payment_history      Json?
  raw_payload          Json?
  pulled_at            DateTime          @default(now()) @db.Timestamptz(6)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  bureau_accounts      bureau_accounts[]
  loan_applications    loan_applications @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([loan_id])
  @@index([score])
}


model appointments {
  id              String   @id @default(uuid()) @db.Uuid
  loan_id         String   @db.Uuid
  branch_id       String   @db.Uuid
  customer_id     String   @db.Uuid
  preferred_date  DateTime @db.Date
  preferred_slot  String   @db.VarChar(50)
  status          String   @default("BOOKED") @db.VarChar(30)
  visit_notes     String?  @db.VarChar(500)
  arrived_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)
  loan_application loan_applications @relation(fields: [loan_id], references: [id])
  branch          branches           @relation(fields: [branch_id], references: [id])
  customer        customers          @relation(fields: [customer_id], references: [id])

  @@index([loan_id])
  @@index([branch_id])
  @@index([customer_id])
  @@index([status])
  @@index([preferred_date])
}

model collateral_gold {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id            String            @unique @db.Uuid
  net_weight_grams   Decimal           @db.Decimal(8, 2)
  gross_weight_grams Decimal           @db.Decimal(8, 2)
  purity_karat       Int               @db.SmallInt
  rate_per_gram      Decimal           @db.Decimal(10, 2)
  valuation          Decimal           @db.Decimal(15, 2)
  ltv_pct            Decimal           @db.Decimal(5, 2)
  items              Json
  valued_by          String            @db.VarChar(100)
  valued_at          DateTime          @default(now()) @db.Timestamptz(6)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  custody_status     String            @default("IN_CUSTODY") @db.VarChar(20)
  vault_location     String?           @db.VarChar(100)
  received_at        DateTime          @default(now()) @db.Timestamptz(6)
  released_at        DateTime?         @db.Timestamptz(6)
  released_by        String?           @db.VarChar(100)
  release_reason     String?           @db.VarChar(30)
  loan_applications  loan_applications @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([loan_id])
  @@index([custody_status])
}

model collateral_property {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id            String            @unique @db.Uuid
  property_type      String            @db.VarChar(50)
  address            String            @db.VarChar(300)
  market_value       Decimal           @db.Decimal(15, 2)
  ltv_pct            Decimal           @db.Decimal(5, 2)
  builder_name       String?           @db.VarChar(100)
  construction_stage String?           @db.VarChar(50)
  valued_at          DateTime          @default(now()) @db.Timestamptz(6)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  loan_applications  loan_applications @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([loan_id])
}

model roles {
  name        String   @id @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  permissions role_permissions[]
}

model role_permissions {
  id          String   @id @default(uuid()) @db.Uuid
  role_name   String   @db.VarChar(50)
  module      String   @db.VarChar(50)
  action      String   @default("READ") @db.VarChar(20)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  role        roles    @relation(fields: [role_name], references: [name])

  @@unique([role_name, module, action])
  @@index([role_name])
  @@index([module])
}

model gl_accounts {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique @db.VarChar(20)
  name          String          @db.VarChar(100)
  type          String          @db.VarChar(20)
  normal_balance String         @db.VarChar(10)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)
  debit_entries  journal_entries[] @relation("DebitAccount")
  credit_entries journal_entries[] @relation("CreditAccount")

  @@index([code])
  @@index([type])
}

model journal_entries {
  id              String      @id @default(uuid()) @db.Uuid
  entry_date      DateTime    @db.Date
  reference_type  String      @db.VarChar(50)
  reference_id    String      @db.Uuid
  debit_account   String      @db.VarChar(20)
  credit_account  String      @db.VarChar(20)
  amount          Decimal     @db.Decimal(15, 2)
  narration       String      @db.VarChar(300)
  posted_by       String      @db.VarChar(100)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  debit_gl        gl_accounts @relation("DebitAccount",  fields: [debit_account],  references: [code])
  credit_gl       gl_accounts @relation("CreditAccount", fields: [credit_account], references: [code])

  @@index([reference_type, reference_id])
  @@index([entry_date])
  @@index([debit_account])
  @@index([credit_account])
}

model reconciliation_reports {
  id              String   @id @default(uuid()) @db.Uuid
  run_date        DateTime @db.Date
  report_type     String   @db.VarChar(50)
  status          String   @default("PENDING") @db.VarChar(20)
  total_expected  Decimal  @db.Decimal(15, 2)
  total_actual    Decimal  @db.Decimal(15, 2)
  variance        Decimal  @db.Decimal(15, 2)
  matched_count   Int      @default(0)
  unmatched_count Int      @default(0)
  details         Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([run_date])
  @@index([report_type])
  @@index([status])
}

model admin_refresh_tokens {
  id            String      @id @default(uuid()) @db.Uuid
  admin_user_id String      @db.Uuid
  token_hash    String      @db.Text
  expires_at    DateTime    @db.Timestamptz(6)
  revoked_at    DateTime?   @db.Timestamptz(6)
  ip            String?     @db.VarChar(45)
  user_agent    String?     @db.VarChar(500)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  admin_user    admin_users @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)

  @@index([admin_user_id])
  @@index([token_hash])
  @@index([expires_at])
}

model idempotency_keys {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique @db.VarChar(255)
  request_path String   @db.VarChar(200)
  response     Json
  status_code  Int
  expires_at   DateTime @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([key])
  @@index([expires_at])
}

model number_sequences {
  sequence_key  String   @id @db.VarChar(50)
  current_value Int      @default(0)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model loan_products {
  product_type       String   @id @db.VarChar(30)
  min_amount         Decimal  @db.Decimal(15, 2)
  max_amount         Decimal  @db.Decimal(15, 2)
  min_rate           Decimal  @db.Decimal(5, 2)
  max_rate           Decimal  @db.Decimal(5, 2)
  max_tenure_months  Int      @db.SmallInt
  processing_fee_pct Decimal  @db.Decimal(5, 3)
  insurance_pct      Decimal  @default(0) @db.Decimal(5, 3)
  stamp_duty         Decimal  @default(0) @db.Decimal(10, 2)
  documentation_fee  Decimal  @default(0) @db.Decimal(10, 2)
  max_ltv_pct        Decimal? @db.Decimal(5, 2)
  is_active          Boolean  @default(true)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
  appraiser_fee        Decimal? @default(0) @db.Decimal(10, 2)
  second_appraiser_fee Decimal? @default(0) @db.Decimal(10, 2)
  incidental_charges   Decimal? @default(0) @db.Decimal(10, 2)
}


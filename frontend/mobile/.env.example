# ─────────────────────────────────────────────────────────────────────────────
# .env.example — committed to the repo, never contains real values.
#
# HOW TO USE
# ──────────
# Copy this file to the env file that matches your target environment:
#
#   cp .env.example .env.development   # local dev  (expo start)
#   cp .env.example .env.staging       # staging    (expo start --env staging)
#   cp .env.example .env.production    # production (expo start --env production)
#
# All three copies are gitignored (.env.*). Edit each copy with real values.
#
# For EAS Cloud builds the inline `env` blocks in eas.json are the authoritative
# source (cloud workers don't have access to gitignored files). Keep eas.json
# and these files in sync whenever you change a URL.
#
# EXPO_PUBLIC_* PREFIX
# ────────────────────
# Variables with the EXPO_PUBLIC_ prefix are inlined into the JavaScript
# bundle at build time by Metro. They are visible in the compiled app — do NOT
# put secrets here. Use EAS secrets / Expo environment variables dashboard for
# server-side secrets that must not appear in the bundle.
#
# VALIDATION
# ──────────
# src/core/config/env.ts validates every key below with a Zod schema at app
# startup. Missing or malformed values will:
#   • Print an error to the console in development (and fall back to defaults)
#   • Throw a hard error in production (preventing a misconfigured build from
#     shipping to users)
# ─────────────────────────────────────────────────────────────────────────────


# ── EXPO_PUBLIC_API_URL ───────────────────────────────────────────────────────
# Base URL for the NBFC backend REST API.
# Validated by: z.string().url()
# Must start with https:// in production — api.ts throws at startup if not.
#
# Development example:  http://localhost:3000
#                       http://192.168.1.42:3000  ← LAN IP for physical device
# Staging example:      https://staging-api.yourdomain.in
# Production example:   https://api.yourdomain.in
EXPO_PUBLIC_API_URL=

# ── EXPO_PUBLIC_USE_MOCK ─────────────────────────────────────────────────────
# When "true", all API calls return local fixture data (no network required).
# The string "true" is coerced to a boolean by env.ts.
# env.ts throws a hard error if this is "true" and NODE_ENV is "production",
# so a mock build can never accidentally be submitted to the stores.
#
# Development: true
# Staging:     false
# Production:  false   ← hard-enforced; do not change
EXPO_PUBLIC_USE_MOCK=true

# Production build settings — used by `vite build`.
#
# TODO(owner): replace the API URL with the real production HTTPS host
# (same host as mobile eas.json build.production.env.EXPO_PUBLIC_API_URL).
# Until you do, the app hard-fails at startup — src/config.ts refuses to run a
# production bundle whose VITE_API_URL is missing or still says REPLACE_ME.
# Also update the connect-src host in nginx.conf to match.
#
# TODO(owner): paste the Sentry project DSN to enable crash reporting. A prod
# build with an empty DSN still runs, but logs a loud "monitoring is OFF" warning.
#
# VITE_USE_MOCK must stay false: src/config.ts hard-fails a production
# bundle that ships in mock mode.
VITE_API_URL=https://api.REPLACE_ME.in/api/v1
VITE_APP_NAME=Fuehrer NBFC Admin Panel
VITE_USE_MOCK=false
VITE_SENTRY_DSN=
